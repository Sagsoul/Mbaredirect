# ──────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────
# Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard → Project Settings → API → anon/public key
# (Newer Supabase projects label this as the "Publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Project Settings → API → service_role key (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────
# Cron
# ──────────────────────────────────────────
# A random secret to authenticate cron-triggered API routes
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mbaredirect.co.zw
